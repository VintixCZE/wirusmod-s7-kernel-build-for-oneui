# Size trim level 1: features a phone cannot use or that are not NetHunter related.
# Applied by the CI build on top of moro + pie + flat defconfigs (see build.yml).
# One option per line, in the form "# CONFIG_X is not set".

# ath9k PCI/AHB driver (useless on a phone). The USB driver ATH9K_HTC (AR9271) stays.
# CONFIG_ATH9K is not set

# DVB / SDR kernel drivers. rtl-sdr, HackRF and Airspy tools use libusb in userspace.
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_DVB_NET is not set
# CONFIG_DVB_USB_V2 is not set
# CONFIG_DVB_USB_RTL28XXU is not set
# CONFIG_USB_AIRSPY is not set
# CONFIG_USB_HACKRF is not set
# CONFIG_USB_MSI2500 is not set

# Keyspan USB serial adapters
# CONFIG_USB_SERIAL_KEYSPAN_MPR is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA18X is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA19 is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA19QI is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA19QW is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA19W is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA28 is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA28X is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA28XA is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA28XB is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA49W is not set
# CONFIG_USB_SERIAL_KEYSPAN_USA49WLC is not set

# Optical disc / UDF filesystems
# CONFIG_ISO9660_FS is not set
# CONFIG_ZISOFS is not set
# CONFIG_UDF_FS is not set

# F2FS: the stock Samsung kernel has none and Samsung Pie uses ext4 for /data
# CONFIG_F2FS_FS is not set

# ebtables (bridge firewalling)
# CONFIG_BRIDGE_NF_EBTABLES is not set

# Old USB ethernet and USB bluetooth dongle drivers
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_CATC is not set
# CONFIG_BT_ATH3K is not set
# CONFIG_BT_HCIBCM203X is not set
# CONFIG_BT_HCIBFUSB is not set
# CONFIG_BT_HCIBPA10X is not set

# Built-in self tests
# CONFIG_CRYPTO_TEST is not set
# CONFIG_ATOMIC64_SELFTEST is not set
