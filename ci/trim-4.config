# Size trim level 4 (adds to levels 1-3): tracing and unused built-in extras.
# The ION stat log is a debug statistics feature that defaults to y and selects
# TRACING; switching it off lets the whole tracing subsystem (TRACING,
# EVENT_TRACING, TRACEPOINTS, RING_BUFFER) drop out. Resolved with kconfig.
# If the build fails to compile after this level, build with trim_level 3.
# CONFIG_ION_EXYNOS_STAT_LOG is not set
# CONFIG_TRACING is not set
# CONFIG_EVENT_TRACING is not set
# CONFIG_BLK_DEV_IO_TRACE is not set

# CPU governors that the working stock kernel does not have
# CONFIG_CPU_FREQ_GOV_INTERACTIVES9 is not set
# CONFIG_CPU_FREQ_GOV_THUNDERSTORM is not set
# CONFIG_CPU_FREQ_GOV_THUNDERSTORM2 is not set
# CONFIG_CPU_FREQ_GOV_INTELLIMM is not set
# CONFIG_CPU_FREQ_GOV_ZZMOOVE is not set

# dm-verity and cachefiles are absent from the stock kernel
# CONFIG_DM_VERITY is not set
# CONFIG_CACHEFILES is not set
